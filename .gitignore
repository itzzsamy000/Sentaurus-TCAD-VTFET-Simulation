# ============================================================
# .gitignore for Synopsys Sentaurus TCAD Simulation Project
# ============================================================

# ----------------------------
# Flex license log files
# (auto-generated by Sentaurus)
# ----------------------------
flex*.log

# ----------------------------
# Sentaurus run-time / job files
# ----------------------------
*.job
*.sta
*.err
*.out
n*_local.err
gsub.err
gvars.dat
gcomments.dat
interactive.log
SVisualTcl.log
SVisualTcl.log.BAK
glog.txt

# ----------------------------
# Sentaurus internal project state files
# (binary / auto-regenerated)
# ----------------------------
.cmd
.database
.history
.organization
.status
.project/

# ----------------------------
# Large binary simulation output files
# (TDR mesh/result files - can be very large)
# ----------------------------
*.tdr
*.plt

# ----------------------------
# Temporary / OS files
# ----------------------------
Thumbs.db
Desktop.ini
.DS_Store
*~

# ----------------------------
# Environment / secrets
# ----------------------------
.env
*.secret
*.key
*.pem
